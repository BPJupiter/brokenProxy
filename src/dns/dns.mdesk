
///////////////
// DNS Classes

@table(id obsolete question_only class friendly_name rfc_csv)
DNS_ClassTable:
{
    {1    0  0   IN   "Internet"                   "1035"} 
    {2    1  0   CS   "Computer Science Network"   "1035"} 
    {3    0  0   CH   "Chaos"                      "1035"} 
    {4    0  0   HS   "Hesiod"                     "1035"} 
    {254  0  1   NONE "None"                       "2136"} 
    {255  0  1   ANY  "Any"                        "1035"} 
}

@enum DNS_Class:
{
    @expand(DNS_ClassTable a) `$(a.class .. =>12) = $(a.id)`,
}

@enum2string_switch(DNS_Class)
dns_string_from_class:
{
    @expand(DNS_ClassTable a) `case DNS_Class_$(a.class):{result = str8_lit("$(a.class)");}break`;
}

@enum2string_switch(DNS_Class)
dns_friendly_name_from_class:
{
    @expand(DNS_ClassTable a) `case DNS_Class_$(a.class):{result = str8_lit("$(a.friendly_name)");}break`;
}

@enum2bool_switch(DNS_Class)
dns_is_obsolete_class:
{
    @expand(DNS_ClassTable a) `case DNS_Class_$(a.class):{result = $(a.obsolete);}break`;
}

@enum2bool_switch(DNS_Class)
dns_is_query_exclusive_class:
{
    @expand(DNS_ClassTable a) `case DNS_Class_$(a.class):{result = $(a.question_only);}break`;
}

@enum2string_switch(DNS_Class)
dns_rfc_references_from_class:
{
    @expand(DNS_ClassTable a) `case DNS_Class_$(a.class):{result = str8_lit("$(a.rfc_csv)");}break`;
}


