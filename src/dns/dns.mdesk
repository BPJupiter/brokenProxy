@enum DNS_Type:
{
    @expand(DNS_TypeTable a) `$(a.type .. =>12) = $(a.id)`,
}

@gen(enums) // little hack to get the NULL record to compile.
{
    `#undef NULL`
}

@gen
{
    `typedef union DNS_RData DNS_RData;`
    `union DNS_RData {`
    @expand(DNS_TypeTable a)
    ```
struct
{$(a.c_type1 != "" -> '\n' .. a.c_type1 .. ' ' .. a.name1 .. ';')$(a.c_type2 != "" -> '\n' .. a.c_type2 .. ' ' .. a.name2 .. ';')$(a.c_type3 != "" -> '\n' .. a.c_type3 .. ' ' .. a.name3 .. ';')$(a.c_type4 != "" -> '\n' .. a.c_type4 .. ' ' .. a.name4 .. ';')$(a.c_type5 != "" -> '\n' .. a.c_type5 .. ' ' .. a.name5 .. ';')$(a.c_type6 != "" -> '\n' .. a.c_type6 .. ' ' .. a.name6 .. ';')$(a.c_type7 != "" -> '\n' .. a.c_type7 .. ' ' .. a.name7 .. ';')$(a.c_type8 != "" -> '\n' .. a.c_type8 .. ' ' .. a.name8 .. ';')$(a.c_type9 != "" -> '\n' .. a.c_type9 .. ' ' .. a.name9 .. ';')
} $(a.type);```
    `};`
}

@gen(types)
{
    `#define NULL ((void*)0)`
}

@enum2string_switch(DNS_Type)
dns_string_from_type:
{
    @expand(DNS_TypeTable a) `case DNS_Type_$(a.type):{result = str8_lit("$(a.type)");}break`;
}

@enum2bool_switch(DNS_Type)
dns_is_obsolete_type:
{
    @expand(DNS_TypeTable a) `case DNS_Type_$(a.type):{result = $(a.obsolete);}break`;
}

@enum2bool_switch(DNS_Type)
dns_is_query_exclusive_type:
{
    @expand(DNS_TypeTable a) `case DNS_Type_$(a.type):{result = $(a.question_only);}break`;
}

